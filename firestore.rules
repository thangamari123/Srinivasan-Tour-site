rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Srinivasa Tours — Firestore security rules
//
// Authorization is decided ONLY here (and in the Cloudflare Worker for R2),
// never by the frontend. An admin is a signed-in user whose UID has a document
// in /admins with active == true. Admin documents can only be created from the
// Firebase console or by an existing "admin"-role user — there is no self sign-up.
//
// Roles:
//   admin  → full access (create, update, delete, settings, admin users)
//   editor → create & update content, upload media; cannot delete or manage settings
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.active == true
        && adminDoc().data.role in ['admin', 'editor'];
    }

    function isAdmin() {
      return isStaff() && adminDoc().data.role == 'admin';
    }

    function validStatus(data) {
      return data.status in ['active', 'inactive'];
    }

    function hasTimestamps(data) {
      return data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // createdAt must not be rewritten on update
    function keepsCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    function validSlug(slug) {
      return slug is string && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() <= 80;
    }

    // ── admin users ──────────────────────────────────────────────────────────
    // Never publicly readable. A user may read only their own admin record
    // (needed for the login check and by the Cloudflare Worker).
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['admin', 'editor']
        && request.resource.data.active is bool
        && request.resource.data.email is string
        // an admin cannot demote / deactivate themselves (prevents lock-out)
        && (uid != request.auth.uid
            || (request.resource.data.role == 'admin' && request.resource.data.active == true));
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ── tour packages ────────────────────────────────────────────────────────
    function validPackage(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && validSlug(d.slug)
        && validStatus(d)
        && d.featured is bool
        && d.categoryId is string
        && d.durationDays is int && d.durationDays >= 1
        && (d.price == null || d.price is number)
        && (d.discountPrice == null || d.discountPrice is number)
        && d.gallery is list && d.gallery.size() <= 60
        && d.highlights is list && d.itinerary is list
        && d.inclusions is list && d.exclusions is list
        // Travel Reels: optional (older packages don't have it); IDs are validated client-side
        // and re-validated before rendering, so only youtube.com/embed/<11-char id> is ever used.
        && (!('travelVideos' in d) || (d.travelVideos is list && d.travelVideos.size() <= 20));
    }

    match /tourPackages/{id} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create: if isStaff() && validPackage(request.resource.data) && hasTimestamps(request.resource.data);
      allow update: if isStaff() && validPackage(request.resource.data)
        && keepsCreatedAt() && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    // ── destinations & categories ────────────────────────────────────────────
    match /destinations/{id} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create: if isStaff() && validSlug(request.resource.data.slug)
        && validStatus(request.resource.data) && hasTimestamps(request.resource.data);
      allow update: if isStaff() && validSlug(request.resource.data.slug)
        && validStatus(request.resource.data) && keepsCreatedAt();
      allow delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create: if isStaff() && validSlug(request.resource.data.slug)
        && validStatus(request.resource.data) && hasTimestamps(request.resource.data);
      allow update: if isStaff() && validSlug(request.resource.data.slug)
        && validStatus(request.resource.data) && keepsCreatedAt();
      allow delete: if isAdmin();
    }

    // ── homepage sections (fixed document ids) ───────────────────────────────
    match /homepage/{section} {
      allow read: if true;
      allow create, update: if isStaff()
        && section in ['hero', 'services', 'featured', 'destinations', 'banners', 'about', 'reels', 'testimonials', 'cta'];
      allow delete: if isAdmin();
    }

    // ── testimonials ─────────────────────────────────────────────────────────
    match /testimonials/{id} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create, update: if isStaff()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && validStatus(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── media library (metadata only — binaries live in Cloudflare R2) ──────
    match /media/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.key is string && request.resource.data.key.size() > 0
        && request.resource.data.url is string && request.resource.data.url.matches('https?://.*')
        && request.resource.data.fileName is string
        && request.resource.data.size is int && request.resource.data.size > 0
        && request.resource.data.contentType.matches('image/(jpeg|png|webp|gif|avif)')
        && request.resource.data.uploadedAt is timestamp;
      allow update: if isStaff() && request.resource.data.key == resource.data.key
        && request.resource.data.url == resource.data.url;
      allow delete: if isAdmin();
    }

    // ── activity log (append-only) ───────────────────────────────────────────
    match /activityLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── settings ─────────────────────────────────────────────────────────────
    // settings/public may be shown on the website; every other settings doc is private.
    match /settings/{docId} {
      allow read: if docId == 'public' || isStaff();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
